# Solo para ejecutar en tu computador. No usar estos valores en producción.
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=clave-local-de-desarrollo-cambiar-en-produccion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_DB_PATH=local.sqlite3

# El chat y la generación con IA usan Ollama de forma opcional.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b

# Opcional: transcripción de audio (requiere requirements-audio.txt y FFmpeg).
WHISPER_MODEL=base

# Opcional: Brevo para enviar correos reales. Sin estas claves, en modo local
# el enlace de verificación se imprime en la terminal.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Pre-ICFES

# Ajustes para despliegue HTTPS (sustituye el dominio de ejemplo):
# DJANGO_ENV=production
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=preicfes.ejemplo.edu.co
# DJANGO_CSRF_TRUSTED_ORIGINS=https://preicfes.ejemplo.edu.co
# DJANGO_TRUST_PROXY_SSL_HEADER=false

# Producción (requiere infraestructura persistente y costos revisados):
# DATABASE_URL=postgresql://usuario:clave@host/db
# DJANGO_DATA_ROOT=/var/data/preicfes
# DJANGO_MULTIINSTITUCION=false  # Multiinstitución no está habilitada
# DJANGO_DB_SSL_REQUIRE=true  # Si el proveedor exige TLS para PostgreSQL
# En Render configurar hosts y orígenes HTTPS del servicio real.
