# Solo para ejecutar en tu computador. No usar estos valores en producción.
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=clave-local-de-desarrollo-cambiar-en-produccion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_DB_PATH=local.sqlite3

# El chat y la generación con IA usan Ollama de forma opcional.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b

# Opcional: transcripción de audio (requiere requirements-audio.txt y FFmpeg).
WHISPER_MODEL=base

# Opcional: Brevo para enviar correos reales. Sin estas claves, en modo local
# el enlace de verificación se imprime en la terminal.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Pre-ICFES
